# ---------------------------------------------------------------------------
# Fichier EXEMPLE versionne sur Git — a copier en passwords.yaml apres clone :
#   Windows :  copy config\passwords.yaml.example config\passwords.yaml
#   macOS/Linux : cp config/passwords.yaml.example config/passwords.yaml
#
# Ne commitez JAMAIS le vrai passwords.yaml (il reste dans .gitignore).
# Les valeurs ci-dessous suffisent pour demarrer le serveur en local avec
# Docker (Postgres mot de passe = celui de docker-compose.yaml).
# Pour les e-mails (codes inscription / reset) et Google : remplacer SMTP
# et googleClientSecret par vos identifiants (voir guide_d_installation.txt).
# ---------------------------------------------------------------------------

development:
  # Identique a POSTGRES_PASSWORD dans cine_pass_server/docker-compose.yaml
  database: "mervy"

  # Chaines de demonstration (longueur suffisante pour Serverpod). A changer
  # en production ; pour un cours / soutenance locales, peuvent rester telles quelles.
  jwtRefreshTokenHashPepper: "CinePassDemoRefreshPepper2025min10chars"
  jwtHmacSha512PrivateKey: "CinePassDemoHmacSha512PrivateKey0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF01"
  emailSecretHashPepper: "CinePassDemoEmailPepper10"

  # SMTP (Gmail : activer validation 2 etapes puis "mot de passe application")
  smtpHost: "smtp.gmail.com"
  smtpPort: "587"
  smtpUsername: "votre_compte@gmail.com"
  smtpPassword: "xxxx xxxx xxxx xxxx"
  smtpFromEmail: "votre_compte@gmail.com"
  smtpFromName: "CinePass"

  # JSON client OAuth Web (Google Cloud Console). Tant que client_id / secret
  # sont des placeholders, la connexion Google ne fonctionnera pas ; le reste de l'app oui.
  googleClientSecret: '{"web":{"client_id":"REMPLACER_PAR_VOTRE_CLIENT_ID.apps.googleusercontent.com","project_id":"votre-projet","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"REMPLACER_PAR_VOTRE_CLIENT_SECRET","redirect_uris":["http://localhost:9080/auth/google/callback"]}}'

  # Role admin : table cine_pass_admin_user — voir scripts/promote_admin_by_email.sql
