# Copier ce fichier en passwords.yaml après un clone :
#   cp config/passwords.yaml.example config/passwords.yaml
# Puis remplacer les valeurs.
# Ne jamais commiter passwords.yaml !

development:
  database: "MOT_DE_PASSE_POSTGRES"   # avec Docker : mervy (voir docker-compose.yaml)
  # Auth Serverpod (JWT + Google)
  jwtRefreshTokenHashPepper: "une-chaine-secrete-min-10-caracteres"
  jwtHmacSha512PrivateKey: "cle-privee-hmac-sha512-min-64-caracteres-xxxxxxxxxx"
  # JSON Google web client secret (copie du contenu de google_client_secret.json)
  googleClientSecret: '{"web":{"client_id":"xxx.apps.googleusercontent.com","project_id":"your-project","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"your-client-secret","redirect_uris":["http://localhost:9080/auth/google/callback"]}}'
  # Email (SMTP) pour envoyer les codes de vérification (inscription + reset)
  # Exemple Gmail: utilise un "app password" (mot de passe application) si possible.
  smtpHost: "smtp.gmail.com"
  smtpPort: "587"
  smtpUsername: "ton_compte@gmail.com"
  smtpPassword: "TON_APP_PASSWORD"
  smtpFromEmail: "ton_compte@gmail.com"
