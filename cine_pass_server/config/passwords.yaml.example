# =============================================================================
# MODELE VERSIONNE (a copier en passwords.yaml apres chaque clone)
# =============================================================================
# Windows (PowerShell ou CMD), depuis cine_pass_server :
#   copy config\passwords.yaml.example config\passwords.yaml
# macOS / Linux :
#   cp config/passwords.yaml.example config/passwords.yaml
#
# Le fichier passwords.yaml reel ne doit PAS etre committe (voir .gitignore).
# Les valeurs ci-dessous suffisent pour Postgres Docker du projet (mot de passe
# "mervy"). Remplacez SMTP et googleClientSecret pour emails et login Google.
# =============================================================================

development:
  # Doit correspondre a POSTGRES_PASSWORD dans docker-compose.yaml (service postgres)
  database: "mervy"

  # Chaines de test (assez longues pour Serverpod). A changer en production.
  jwtRefreshTokenHashPepper: "dev-pepper-refresh-token-minimum-dix-caracteres"
  jwtHmacSha512PrivateKey: "dev-hmac-sha512-cle-minimum-soixante-quatre-caracteres-pour-tests-locaux-uniquement-xx"
  emailSecretHashPepper: "dev-pepper-email-min-dix"

  # SMTP : necessaire pour les codes d'inscription / mot de passe oublie.
  # Laissez les placeholders si vous ne testez que le reste ; sinon mettez Gmail + mot de passe d'application.
  smtpHost: "smtp.gmail.com"
  smtpPort: "587"
  smtpUsername: "votre_compte@gmail.com"
  smtpPassword: "mot-de-passe-application-gmail"
  smtpFromEmail: "votre_compte@gmail.com"
  smtpFromName: "CinePass"

  # OAuth Google (Web) : JSON sur une seule ligne. Connexion Google inactive tant que non remplace.
  # Creer un client OAuth Web dans Google Cloud Console ; redirect : http://localhost:9080/auth/google/callback
  googleClientSecret: '{"web":{"client_id":"VOTRE-ID.apps.googleusercontent.com","project_id":"votre-projet","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"VOTRE-SECRET","redirect_uris":["http://localhost:9080/auth/google/callback"]}}'

# Admin : roles en base (table cine_pass_admin_user). Voir scripts/promote_admin_by_email.sql
